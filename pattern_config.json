{
  "pattern_recognition": {
    "socket_path": "/tmp/pattern.sock",
    
    "thresholds": {
      "co_occurrence_threshold": 3,
      "sequence_threshold": 2,
      "cluster_threshold": 4
    },
    
    "decay": {
      "decay_rate": 0.1,
      "decay_interval_seconds": 60,
      "max_age_co_occurrence_seconds": 300,
      "max_age_sequence_seconds": 300,
      "max_age_cluster_seconds": 600
    },
    
    "limits": {
      "max_recent_items": 10,
      "max_recent_concepts": 20,
      "max_stored_patterns": 10000
    },
    
    "sequence_detection": {
      "max_time_gap_seconds": 30,
      "min_confidence": 0.2
    },

    "self_observation": {
      "interval_seconds": 45,
      "broadcast_throttle_seconds": 120,
      "mystery_escalation_threshold": 3,
      "max_mysteries": 20
    }
  }
}

