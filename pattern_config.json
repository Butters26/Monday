{
  "pattern_recognition": {
    "socket_path": "/tmp/pattern.sock",
    "thresholds": {
      "co_occurrence_threshold": 3,
      "sequence_threshold": 2,
      "cluster_threshold": 4
    },
    "decay": {
      "decay_rate": 0.1,
      "decay_interval_seconds": 60,
      "max_age_co_occurrence_seconds": 300,
      "max_age_sequence_seconds": 300,
      "max_age_cluster_seconds": 600
    },
    "limits": {
      "max_recent_items": 10,
      "max_recent_concepts": 20,
      "max_stored_patterns": 10000,
      "sequence_detect_slice": 20,
      "max_composed_sequence_length": 32,
      "local_seq_lengths": [
        3,
        4,
        5
      ]
    },
    "sequence_detection": {
      "max_time_gap_seconds": 30,
      "min_confidence": 0.2
    },
    "compose": {
      "min_token_diversity": 0.35,
      "max_dominant_token_fraction": 0.6,
      "min_unique_tokens": 2,
      "max_compose_per_observe": 4
    },
    "short_seq_near_dup": {
      "enabled": true,
      "max_length": 3,
      "min_run_length": 2
    },
    "signal_combo_discovery": {
      "min_combo_size": 2,
      "max_combo_size": 4,
      "max_candidates": 200,
      "max_new_per_observe": 4,
      "max_subsets_per_observe": 6,
      "durable_occurrences": 3,
      "significant_confidence": 0.6
    }
  }
}
