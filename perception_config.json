{
  "perception": {
    "socket_path": null,
    "notes": "Live path: PerceptionLobe senses (text required; audio/vision when device open succeeds). Unified thalamus shape. No autonomous theater loops.",

    "input_types": {
      "text": {
        "enabled": true,
        "default": true
      },
      "audio": {
        "enabled": "when_available",
        "require_speech_recognition": true,
        "require_microphone_open": true,
        "timeout_seconds": 5,
        "phrase_time_limit_seconds": 10
      },
      "visual": {
        "enabled": "when_available",
        "require_opencv": true,
        "require_camera_open": true,
        "camera_index": 0
      }
    },

    "unified_output": [
      "modality",
      "text",
      "concepts",
      "entities",
      "novelty_flags",
      "confidence",
      "raw_meta"
    ],

    "message_types": [
      "perceive_text",
      "perceive_audio",
      "perceive_vision",
      "get_status"
    ],

    "text_processing": {
      "extract_concepts": true,
      "detect_questions": true,
      "detect_emotions": true,
      "min_word_length": 2
    },

    "question_words": [
      "what",
      "why",
      "how",
      "when",
      "where",
      "who",
      "which"
    ],

    "emotion_keywords": {
      "happy": ["happy", "joy", "great", "wonderful", "amazing"],
      "sad": ["sad", "unhappy", "depressed", "down"],
      "angry": ["angry", "mad", "furious", "hate"],
      "excited": ["excited", "thrilled", "amazing"],
      "worried": ["worried", "anxious", "concerned", "scared"]
    },

    "entity_detection": {
      "enabled": true,
      "detect_capitalized": true,
      "min_word_length": 2
    }
  }
}
