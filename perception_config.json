{
  "perception": {
    "socket_path": "/tmp/perception.sock",
    
    "input_types": {
      "text": {
        "enabled": true,
        "default": true
      },
      "audio": {
        "enabled": false,
        "require_speech_recognition": true,
        "timeout_seconds": 5,
        "phrase_time_limit_seconds": 10
      },
      "visual": {
        "enabled": false,
        "require_opencv": true,
        "camera_index": 0
      }
    },
    
    "text_processing": {
      "extract_concepts": true,
      "detect_questions": true,
      "detect_emotions": true,
      "min_word_length": 3
    },
    
    "question_words": [
      "what",
      "why",
      "how",
      "when",
      "where",
      "who",
      "which"
    ],
    
    "emotion_keywords": {
      "happy": ["happy", "joy", "great", "wonderful", "amazing"],
      "sad": ["sad", "unhappy", "depressed", "down"],
      "angry": ["angry", "mad", "furious", "hate"],
      "excited": ["excited", "thrilled", "amazing"],
      "worried": ["worried", "anxious", "concerned", "scared"]
    },
    
    "entity_detection": {
      "enabled": true,
      "detect_capitalized": true,
      "min_word_length": 2
    }
  }
}

