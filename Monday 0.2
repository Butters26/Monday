def start_lobe(script_path: str, wait_time: float = 0.5):
    """Start a lobe in background - errors shown in terminal AND logged"""
    log_path = f"{script_path.replace('.py', '')}_startup.log"
    log_file = open(log_path, 'a')
    log_file.write(f"\n{'='*70}\n")
    log_file.write(f"Starting {script_path} at {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
    log_file.write(f"{'='*70}\n")
    log_file.flush()
    
    # Use PIPE to capture output
    proc = subprocess.Popen(
        [sys.executable, script_path],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        stdin=subprocess.DEVNULL,
        bufsize=0,
        text=True,
        start_new_session=True
    )
    
    # Thread to read output and show errors in terminal + log everything
    def read_output():
        for line in proc.stdout:
            line = line.rstrip()
            # Show errors in terminal immediately
            if any(keyword in line for keyword in ['error', 'Error', 'ERROR', 'Exception', 'Traceback', 'SyntaxError', 'IndentationError']):
                print(f"  ❌ {script_path}: {line}")
            # Also log everything
            log_file.write(line + '\n')
            log_file.flush()
        log_file.close()
    
    thread = threading.Thread(target=read_output, daemon=True)
    thread.start()
    proc._log_file = log_file
    proc._output_thread = thread
    time.sleep(wait_time)
    return proc

