            elif emotion in ['worried', 'scared', 'anxious']:
                # Add uncertainty
                if not text.endswith('...'):
                    text = f"{text}..."
            
            elif emotion in ['angry', 'frustrated']:
                # Add intensity
                if intensity > 0.8:
