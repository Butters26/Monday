                    time_str = "??"
                summary_parts.append(f"{time_str} [{role}]: {content}")
            
            return "\n".join(summary_parts)
            
        except Exception as e:
            logger.error(f"Failed to get conversation summary: {e}")
            return "Error retrieving conversation history."

